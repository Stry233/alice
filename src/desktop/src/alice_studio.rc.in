/* Windows resource file — embeds the app icon and VERSIONINFO block
 * into AliceStudio.exe so File Explorer, the Start Menu, Properties ->
 * Details, and Task Manager all show a proper icon and publisher name
 * instead of "AliceStudio.exe" with an empty icon and blank fields.
 *
 * Templated by CMake (see AliceStudio target in CMakeLists.txt) — the
 * @CMAKE_VAR@ placeholders get substituted with the PROJECT_VERSION
 * and the absolute icon path at configure time.
 */

/* 1 as the icon ID makes this the default program icon — Windows
 * picks it for the shell because the first numerically-keyed ICON
 * resource in an exe is the one the Explorer uses. */
1 ICON "@ALICE_ICON_PATH@"

/* Inlining the winver.h constants (rather than #include <winver.h>)
 * sidesteps MinGW windres's preprocessor entirely — otherwise windres
 * invokes gcc -E and chokes when the project lives under a path with
 * ` - ` in it (e.g. OneDrive folders), interpreting the dash fragment
 * as an unrecognized command-line option. With no #include directives
 * here, the .rc compiles without needing a working cpp pass. */

1 VERSIONINFO
 FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,0,0
 PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          0x00000004L   /* VOS__WINDOWS32 */
 FILETYPE        0x00000001L   /* VFT_APP */
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        /* 040904b0 = US English / Unicode. Widest shell compatibility. */
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Selka"
            VALUE "FileDescription",  "Alice Studio"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "AliceStudio"
            VALUE "LegalCopyright",   "\251 2026 Selka"
            VALUE "OriginalFilename", "AliceStudio.exe"
            VALUE "ProductName",      "Alice Studio"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
